
# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Ollama (nếu chạy Ollama trên máy host và Docker Desktop)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Docker mặc định dùng CPU; đặt cuda nếu container được cấu hình NVIDIA GPU.
# EMBEDDING_DEVICE=cpu
# RERANKER_DEVICE=cpu

# Auth (bắt buộc khi đặt RAG_ENV=production; tối thiểu 32 ký tự)
# RAG_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Environment
RAG_ENV=development
LOG_LEVEL=INFO
